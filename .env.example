# Copy to .env.local for `vercel dev`; set the same keys in Vercel → Settings → Environment Variables.
# Only SUPABASE_URL and SUPABASE_ANON_KEY ever reach the browser (via the config block in index.html).

SUPABASE_URL=
# Legacy "anon" key or the newer "publishable" key (sb_publishable_...). Also pasted into index.html.
SUPABASE_ANON_KEY=
# Legacy "service_role" key or the newer "secret" key (sb_secret_...). Server only.
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# https://<app>.vercel.app/api/google/callback
GOOGLE_REDIRECT_URI=

ANTHROPIC_API_KEY=

# Vercel sends "Authorization: Bearer <CRON_SECRET>" to cron routes. Generate: openssl rand -hex 32
CRON_SECRET=
# HMAC key for the Google OAuth `state` parameter. Generate: openssl rand -hex 32
OAUTH_STATE_SECRET=

# https://<app>.vercel.app  (no trailing slash)
APP_URL=
